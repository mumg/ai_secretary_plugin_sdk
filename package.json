{
  "name": "@ai-secretary/plugin-sdk",
  "version": "0.2.0",
  "description": "Node.js SDK for AI Secretary conversation and task source plugins",
  "type": "module",
  "main": "./index.mjs",
  "types": "./index.d.ts",
  "engines": { "node": ">=24" },
  "files": ["index.mjs", "index.d.ts", "README.md", "LICENSE", "docs/"],
  "keywords": ["ai-secretary", "plugin", "sdk", "conversation", "integration"],
  "homepage": "https://github.com/mumg/ai_secretary_plugin_sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mumg/ai_secretary_plugin_sdk.git"
  },
  "bugs": { "url": "https://github.com/mumg/ai_secretary_plugin_sdk/issues" },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.mjs"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "prepublishOnly": "npm test"
  }
}
